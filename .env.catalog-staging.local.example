# Copie para .env.catalog-staging.local (ignorado pelo Git) e chmod 600.
DATABASE_URL=postgresql://catalog_staging:SUBSTITUA_SENHA_LOCAL@127.0.0.1:15439/unico_catalog_staging_local?schema=sistema
DEPLOYMENT_ENCRYPTION_KEY=
HUBUNICO_STAGING_BASE_URL=https://api.unicocontato.ia.br/hubunico-staging
HUBUNICO_STAGING_ADMIN_API_KEY=
CATALOG_LOCAL_FULL_FLOW_ENABLED=false
CATALOG_LOCAL_STAGING_SERVER=true
CATALOG_LOCAL_STOREFRONT_BASE_URL=
BANCO_UNICO_STAGING_BASE_URL=
BANCO_UNICO_STAGING_AUTHORIZATION=
# Opcional: feed HTTPS com staging no host/caminho. Vazio bloqueia o AtenderBem
# local até configurar; nunca use o feed de produção com IDs de staging.
CATALOG_ATENDERBEM_FEED_BASE_URL=
UNICOMMERCE_BACK_STAGING_BASE_URL=
UNICOMMERCE_BACK_STAGING_INTERNAL_API_KEY=
STOREFRONT_PROVISIONING_ENABLED=false
VERCEL_STAGING_API_TOKEN=
VERCEL_STAGING_TEAM_ID=
VERCEL_STAGING_PROJECT_ID=
AUTOMATIZA_MYSQL_TLS_CA=
DEPLOYMENT_HUB_POLL_INTERVAL_MS=5000
DEPLOYMENT_WORKER_INTERVAL_MS=1000
